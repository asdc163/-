# ─── fal.ai Video Generation (Kling 2.6 Pro) ─────────────────────────────────
# Register at https://fal.ai → Dashboard → API Keys
# New accounts get $1 free credits (~10 videos at 5s each)
# Pricing: $0.07/sec without audio, $0.14/sec with native audio
FAL_AI_KEY=your_fal_ai_key_here

# ─── Seedance 2.0 (官方 API 上線後切換，預計 2026-02-24) ─────────────────────
# 切換時設定：VIDEO_PROVIDER=seedance + SEEDANCE_API_KEY
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=https://api.laozhang.ai/v1

# ─── TikHub API (Trending Topics) ────────────────────────────────────────────
# Register at https://tikhub.io — free trial credits available
TIKHUB_API_KEY=

# ─── TikTok Content Posting API ──────────────────────────────────────────────
# Register at https://developers.tiktok.com → Content Posting API
# Requires video.publish scope approval
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ─── Optional: OpenAI for AI-generated SEO copy ──────────────────────────────
OPENAI_API_KEY=

# ─── App Configuration ───────────────────────────────────────────────────────
FORCE_MOCK=false
TARGET_REGION=US
POSTS_PER_DAY=3
