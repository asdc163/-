# ─── Seedance 2.0 Video Generation ──────────────────────────────────────────
# Option A: api.laozhang.ai (third-party, currently working)
SEEDANCE_API_KEY=sk-laozhang-xxxxxxxxxxxxx
SEEDANCE_BASE_URL=https://api.laozhang.ai/v1

# Option B: Volcengine ARK (official ByteDance, expected ~2026-02-24)
# VOLCENGINE_ARK_KEY=ark-xxxxxxxx

# ─── TikHub API (Trending Topics) ────────────────────────────────────────────
# Register at https://tikhub.io — free trial credits available
TIKHUB_API_KEY=your_tikhub_token_here

# ─── TikTok Content Posting API ──────────────────────────────────────────────
# Register app at https://developers.tiktok.com
# Requires Content Posting API product + video.upload scope approval
TIKTOK_ACCESS_TOKEN=act.xxxxxxxxxxxxxx

# ─── Optional: OpenAI for enhanced SEO copy generation ───────────────────────
# Leave empty to use rule-based SEO (no key needed)
OPENAI_API_KEY=

# ─── App Configuration ───────────────────────────────────────────────────────
# Set to "true" to force mock mode even with real API keys (for demos)
FORCE_MOCK=false
