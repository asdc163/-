#!/bin/bash
# =============================================================
# 龍蝦雲 Cloud-Init 自動安裝腳本
# 由 provision_cloud.py 動態產生，請勿手動修改
#
# User ID  : {{ user_id }}
# Plan     : {{ plan_name }}
# Platform : {{ platform }}
# =============================================================
set -euo pipefail

LOG="/var/log/openclaw-init.log"
exec > >(tee -a "$LOG") 2>&1

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"; }

log "====== 龍蝦雲 Init 開始 ======"

# ── 1. 系統更新 ────────────────────────────────────────────────
log "[1/7] 系統更新..."
export DEBIAN_FRONTEND=noninteractive
apt-get update -y -q
apt-get upgrade -y -q
apt-get install -y -q curl wget git ufw fail2ban logrotate

# ── 2. 安裝 Node.js 22 LTS ─────────────────────────────────────
# OpenClaw 官方要求 Node.js >= 22
log "[2/7] 安裝 Node.js 22 LTS..."
curl -fsSL https://deb.nodesource.com/setup_22.x | bash - > /dev/null 2>&1
apt-get install -y -q nodejs
NODE_VER=$(node -v)
NPM_VER=$(npm -v)
log "  Node $NODE_VER / npm $NPM_VER"

# 版本保障：確認 ≥ 22
NODE_MAJOR=$(node -e "process.stdout.write(String(process.version.split('.')[0].replace('v','')))")
if [ "$NODE_MAJOR" -lt 22 ]; then
  log "ERROR: Node.js 版本不足（需要 >= 22，目前 $NODE_VER），終止安裝"
  exit 1
fi

# ── 3. 安裝 OpenClaw（最新版）────────────────────────────────────
log "[3/7] 安裝 OpenClaw..."
npm install -g openclaw@latest --silent
OPENCLAW_VERSION=$(openclaw --version 2>/dev/null || echo "installed")
log "  OpenClaw $OPENCLAW_VERSION"

# ── 4. 建立 openclaw 系統用戶 ──────────────────────────────────
log "[4/7] 設定用戶與目錄..."
useradd --system --create-home --shell /bin/bash openclaw 2>/dev/null || true
OPENCLAW_HOME="/home/openclaw"
OPENCLAW_CONFIG_DIR="$OPENCLAW_HOME/.openclaw"
mkdir -p "$OPENCLAW_CONFIG_DIR" /var/log/openclaw

# ── 5. 寫入 openclaw.json ──────────────────────────────────────
log "[5/7] 寫入 OpenClaw 設定..."
# Gateway 預設 Port: 18789（官方預設值）
# gateway.mode 需設為 server 才允許遠端連線
cat > "$OPENCLAW_CONFIG_DIR/openclaw.json" << 'OPENCLAW_CONFIG'
{
  "gateway": {
    "mode": "server",
    "port": 18789,
    "host": "0.0.0.0",
    "token": "{{ login_token }}",
    "maxTokens": {{ max_tokens }},
    "maxBotInstances": {{ max_bot_instances }},
    "maxConcurrentUsers": {{ max_concurrent_users }}
  },
  "ai": {
    "provider": "{{ ai_provider }}",
    "apiKey": "{{ ai_api_key }}"
  },
  "messaging": {
    "platform": "{{ platform }}",
    "contact": "{{ contact }}"
  },
  "logging": {
    "level": "info",
    "file": "/var/log/openclaw/gateway.log"
  },
  "meta": {
    "userId": "{{ user_id }}",
    "plan": "{{ plan_name }}",
    "provisionedAt": "{{ provisioned_at }}"
  }
}
OPENCLAW_CONFIG

chown -R openclaw:openclaw "$OPENCLAW_HOME" /var/log/openclaw
chmod 600 "$OPENCLAW_CONFIG_DIR/openclaw.json"
log "  openclaw.json 寫入完成（Port: 18789）"

# ── 6. 建立 systemd 服務 ────────────────────────────────────────
log "[6/7] 建立 systemd 服務..."

# openclaw onboard --install-daemon 是官方推薦的安裝方式
# 它會自動建立 systemd unit 並設定開機啟動
# 以 openclaw 用戶身份執行
sudo -u openclaw openclaw onboard --install-daemon 2>/dev/null || {
  log "  onboard 指令不支援，改用手動 systemd unit..."

  # 備援方案：手動建立 systemd unit
  OPENCLAW_BIN=$(which openclaw)
  cat > /etc/systemd/system/openclaw.service << SYSTEMD_UNIT
[Unit]
Description=OpenClaw Gateway Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=openclaw
WorkingDirectory=$OPENCLAW_HOME
ExecStart=$OPENCLAW_BIN gateway start --config $OPENCLAW_CONFIG_DIR/openclaw.json --no-daemon
ExecReload=/bin/kill -HUP \$MAINPID
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

Restart=always
RestartSec=10
StartLimitInterval=120
StartLimitBurst=5

StandardOutput=append:/var/log/openclaw/gateway.log
StandardError=append:/var/log/openclaw/error.log

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
SYSTEMD_UNIT

  systemctl daemon-reload
  systemctl enable openclaw
}

log "  systemd 服務設定完成（Restart=always，開機自動啟動）"

# Log rotation（避免日誌爆磁碟）
cat > /etc/logrotate.d/openclaw << 'LOGROTATE_CONF'
/var/log/openclaw/*.log {
    daily
    rotate 14
    compress
    delaycompress
    missingok
    notifempty
    postrotate
        systemctl reload openclaw 2>/dev/null || true
    endscript
}
LOGROTATE_CONF

# ── 7. 防火牆 ─────────────────────────────────────────────────
log "[7/7] 防火牆與啟動..."

ufw default deny incoming
ufw default allow outgoing
ufw allow 22/tcp    comment "SSH"
ufw allow 18789/tcp comment "OpenClaw Gateway"  # 官方預設 Port
ufw --force enable

# fail2ban
cat > /etc/fail2ban/jail.local << 'FAIL2BAN_CONF'
[DEFAULT]
bantime  = 3600
findtime = 600
maxretry = 5

[sshd]
enabled = true
FAIL2BAN_CONF

systemctl enable fail2ban
systemctl restart fail2ban

# ── 8. 啟動並確認健康 ─────────────────────────────────────────
systemctl start openclaw 2>/dev/null || true

HEALTH_CHECK_URL="http://127.0.0.1:18789/health"
RETRIES=18
WAIT=5
SUCCESS=false

for i in $(seq 1 $RETRIES); do
  if curl -sf "$HEALTH_CHECK_URL" > /dev/null 2>&1; then
    SUCCESS=true
    log "  健康檢查通過 (嘗試 $i/$RETRIES)"
    break
  fi
  if ! systemctl is-active --quiet openclaw; then
    log "  服務異常停止，查看錯誤："
    journalctl -u openclaw -n 20 --no-pager || true
    break
  fi
  log "  等待服務就緒... ($i/$RETRIES)"
  sleep $WAIT
done

if [ "$SUCCESS" = true ]; then
  echo "OPENCLAW_READY:$(date -u +%s)" > /var/log/openclaw-ready.flag
  log "====== OpenClaw Gateway 運行正常（Port 18789）======"
else
  echo "OPENCLAW_WARNING:$(date -u +%s)" > /var/log/openclaw-ready.flag
  log "====== 警告：服務可能尚未就緒，請手動確認 ======"
fi

log "====== 龍蝦雲 Init 完成 [$(date)] ======"
