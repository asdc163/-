# ============================================================
# 龍蝦雲 環境變數設定範本
# 複製此檔案為 .env 並填入真實值
# ============================================================

# ── AWS 設定（使用 AWS 時必填）─────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_DEFAULT_REGION=ap-northeast-1     # 東京（推薦台灣用戶）
# 可選 region: ap-southeast-1(新加坡), us-east-1(美東), eu-central-1(歐洲)

# ── GCP 設定（使用 GCP 時必填）─────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_ZONE=asia-east1-b                 # 台灣（推薦）
# 可選 zone: asia-southeast1-a(新加坡), us-central1-a(美中)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ── AWS Key Pair（可選，用於 SSH 登入除錯）─────────────────
# AWS_KEY_PAIR_NAME=my-keypair
